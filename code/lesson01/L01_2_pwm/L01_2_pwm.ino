/* 第一课 · 实验 2：PWM —— 它不是"把电压调低"
 *
 * 接线同实验 1，但 LED 必须接在 PWM 引脚上。
 * UNO 的 PWM 引脚：3, 5, 6, 9, 10, 11（板上标有 ~ 符号）
 *
 * 把 LED 从 D8 改接到 D9。
 */

const uint8_t LED = 9;         // 注意：必须是带 ~ 的引脚

void setup() {
  pinMode(LED, OUTPUT);
  Serial.begin(115200);
}

void loop() {
  // 依次停在 4 个亮度上，每个停 3 秒，方便你用万用表测
  const uint8_t levels[] = {0, 64, 128, 255};
  for (uint8_t i = 0; i < 4; i++) {
    analogWrite(LED, levels[i]);
    Serial.print(F("占空比 = "));
    Serial.print((int)levels[i] * 100 / 255);
    Serial.println(F("%"));
    delay(3000);
  }
}

/* 【动手测量】万用表直流电压档，测 D9 对 GND：
 *   占空比   0%  →  ______ V   （应≈0）
 *   占空比  25%  →  ______ V   （应≈1.25）
 *   占空比  50%  →  ______ V   （应≈2.5）
 *   占空比 100%  →  ______ V   （应≈5）
 *
 * 【关键理解 —— 这一条错了，后面全错】
 *   万用表读到 2.5V，不代表引脚在输出 2.5V。
 *   引脚一直在 0V 和 5V 之间高速切换（UNO 上约 490Hz），
 *   只是有一半时间是高电平。万用表读的是"平均值"。
 *   如果你有示波器，接上去会看到方波，而不是一条 2.5V 的直线。
 *
 * 【为什么这件事对本项目至关重要】
 *   电磁铁的发热 ≈ 平均功率。占空比降到 35%，发热就降到约 35%，
 *   但因为线圈有电感（电流来不及归零），吸持力衰减得比发热慢得多。
 *   ——这就是 peak-and-hold 能"既吸得住又不烫"的物理原因。
 *
 * 【顺带】人眼对亮度的感觉是非线性的。占空比 50% 的 LED
 *   看起来远比"一半亮"要亮。所以后面做力度标定时，
 *   不能靠眼睛/耳朵的直觉，必须靠测量。
 */
